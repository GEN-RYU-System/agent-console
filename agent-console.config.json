{
  "port": 4319,
  "salesanchorRoot": "~/salesanchor",
  "newWorktreeScript": "scripts/new-worktree.sh",
  "ledgerLookupScript": "scripts/ledger-lookup.sh",
  "ledgerDir": ".claude-pipeline/active-work.d",
  "claudeBin": "claude",
  "agentsPollMs": 3000,
  "ledgerPollMs": 60000,
  "ringBufferBytes": 1048576,
  "notify": { "macos": true },
  "terminalEnv": { "LANG": "ja_JP.UTF-8" },
  "restoreStaggerMs": 3000,
  "diffBaseRef": "origin/main",
  "diffMaxFileBytes": 1048576,
  "diffSendMaxBytes": 16384,
  "pasteSubmitDelayMs": 2000,
  "ghBin": "gh",
  "prPollMs": 120000,
  "prRefreshMinMs": 10000,
  "pickMaxKeep": 50,
  "pickSendMaxBytes": 16384,
  "pickHtmlInPromptChars": 1500,
  "terminalSmoothScrollMs": 125,
  "uploadMaxBytes": 5242880,
  "uploadMaxKeep": 100,
  "roles": [
    {
      "id": "opus-designer",
      "labelKey": "role.opusDesigner",
      "command": ["/bin/zsh", "-ic", "ccopusgo"],
      "needsWorktree": false,
      "resumeScope": "main",
      "resumeCommand": ["/bin/zsh", "-ic", "ccopusgo --resume"],
      "restoreCommand": ["/bin/zsh", "-ic", "ccopusgo --resume \"$AC_RESUME_ID\""]
    },
    {
      "id": "sonnet-impl",
      "labelKey": "role.sonnetImpl",
      "command": ["/bin/zsh", "-ic", "claude --model sonnet"],
      "needsWorktree": true,
      "resumeScope": "worktree",
      "resumeCommand": ["/bin/zsh", "-ic", "claude --model sonnet --resume"],
      "restoreCommand": ["/bin/zsh", "-ic", "claude --model sonnet --resume \"$AC_RESUME_ID\""]
    },
    { "id": "shell", "labelKey": "role.shell", "command": ["/bin/zsh", "-i"], "needsWorktree": false }
  ]
}
