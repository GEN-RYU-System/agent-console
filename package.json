{
  "name": "agent-console",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "sa-sync": "node scripts/sa-sync.mjs",
    "dev:server": "tsx server/index.ts",
    "build": "node scripts/build-picker-tokens.mjs && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/sa-sync.mjs && npm run build && node dist-server/server/index.js",
    "start:built": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "node scripts/check-design-governance.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "26.4.3",
    "lucide-react": "1.55.0",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.16",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
