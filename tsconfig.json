{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@sa/*": [".sa-cache/frontend/src/*"] }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/unit/**/*.tsx", "tests/e2e", "tests/fixtures/*.ts"]
}
